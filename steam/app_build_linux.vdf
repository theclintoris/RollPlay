// RollPlay -- SteamPipe app build for Linux.
// Replace YOUR_APP_ID and YOUR_LINUX_DEPOT_ID, then run:
//   steamcmd +login <account> +run_app_build ..\steam\app_build_linux.vdf
"AppBuild"
{
    "AppID" "YOUR_APP_ID"
    "Desc" "RollPlay Linux build"
    "BuildOutput" "output/linux"
    "ContentRoot" "../build/linux"
    "SetLive" ""

    "Depots"
    {
        "YOUR_LINUX_DEPOT_ID" "depot_build_linux.vdf"
    }
}
