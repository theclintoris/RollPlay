// RollPlay -- SteamPipe app build for Windows.
// Replace YOUR_APP_ID and YOUR_WINDOWS_DEPOT_ID, then run:
//   steamcmd +login <account> +run_app_build ..\steam\app_build_windows.vdf
//
// Use a dedicated Steamworks build account, never your personal account, and
// keep the Steam Guard code out of this repository.
"AppBuild"
{
    "AppID" "YOUR_APP_ID"
    "Desc" "RollPlay Windows build"
    "BuildOutput" "output/windows"
    "ContentRoot" "../build/windows"
    "SetLive" ""

    "Depots"
    {
        "YOUR_WINDOWS_DEPOT_ID" "depot_build_windows.vdf"
    }
}
